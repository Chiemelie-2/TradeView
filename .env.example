# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_TRANSLATE_API_KEY: Google Cloud Translation API v2 Key.
# Used for real-time dynamic website language translation.
# Add your Google Cloud Translation API key in Settings > Secrets or in .env or via the Google Translate modal
GOOGLE_TRANSLATE_API_KEY=
VITE_GOOGLE_TRANSLATE_API_KEY=

# SMARTSUPP_KEY: Smartsupp Live Chat Key
# Used for real-time customer support chat widget.
# Add your Smartsupp key from smartsupp.com in Settings > Secrets or in .env or via the Smartsupp widget settings modal
SMARTSUPP_KEY=
VITE_SMARTSUPP_KEY=
